[gwrite.megaplot]
document_start = "G21\nG17\nG90\nG0 Z-15\n"
segment_first =  "G0 Z-15\nG0 X{x:.4f} Y{y:.4f}\nG1 Z-30 F20000\n"
segment = "G1 X{x:.4f} Y{y:.4f} F10000\n"
segment_last = "G1 X{x:.4f} Y{y:.4f} F10000\nG0 Z-15\n"
document_end = "G0 Z-15\n"
unit = "mm"
vertical_flip = true
info= "gwrite motor :megaplot profile with Z linear NEMA motor"


[gwrite.megaplot_with_pump]
document_start = "G21\nG17\nG90\nG0 Z-15\n"
segment_first =  "G0 Z-15\nG0 X{x:.4f} Y{y:.4f}\nG1 Z-32 F20000\nG4 P0.500\nG1 Z-30 F20000\n"
segment = "G1 X{x:.4f} Y{y:.4f} F10000\n"
segment_last = "G1 X{x:.4f} Y{y:.4f} F10000\nG0 Z-15\n"
document_end = "G0 Z-15\n"
unit = "mm"
vertical_flip = true
info= "gwrite motor :megaplot_with_pump profile with Z linear NEMA motor - pump markers with compression"



